# Public browser configuration. Never use service_role here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Owner Gemini key: server only, requires authenticated Supabase users.
GEMINI_API_KEY=
# Only the approved model is allowed; no automatic switch to newer models.
GEMINI_MODEL=gemini-3.1-flash-lite
PORT=3000
