# Public browser configuration. Never use service_role here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Optional shared Gemini key: server only, requires authenticated Supabase users.
# Alternatively, each user can supply a personal key in the AI dialog.
GEMINI_API_KEY=
PORT=3000
